{
  "title": "Atana ECC Health Scoring Engine",
  "version": "1.0",
  "bands": {"Green": [85, 100], "Amber": [70, 84.999], "Red": [0, 69.999]},
  "gateOverride": "Stage readiness is Red when score < project.gate_threshold even if other scores are green",
  "loiByStage": {"S1": 2, "S2": 2, "S3": 3, "S4": 4, "S5": 5, "S6": 5},
  "defaultGate": {"S4": 95},
  "aimPct": "present / required at loi — same as atnAimScore",
  "composites": {
    "IH": "0.15*OIR + 0.15*PIR + 0.15*EIR + 0.20*AIR + 0.20*AIM + 0.15*IDS",
    "CS": "IDS_pct",
    "DH": "0.40*DEL_ontime + 0.30*DEL_pub + 0.30*PKG_clear",
    "RS": "0.50*AIM + 0.30*DEL_pub + 0.20*IDS",
    "OR": "0.40*AIM@LOI5 + 0.20*CMMS_bind + 0.20*TWIN_bind + 0.20*ops_docs",
    "TR": "0.25*IDENT + 0.25*IFC + 0.20*COBie + 0.20*AIM + 0.10*TWIN_bind",
    "PH": "0.30*IH + 0.25*DH + 0.20*CS + 0.15*(100*(1-RISK_idx)) + 0.10*min(100,100*WF_thru)",
    "PoH": "weighted average of PH by project.weight else equal"
  },
  "riskIndex": "min(1, (3*P1 + 2*P2 + P3) / risk_norm)",
  "riskNorm": 12,
  "forecastDelayDays": "0.5*hist_slip + 0.3*14*(1-RS/100) + 0.2*7*P1_open",
  "aggregation": "Average numbers then band. Never average RAG colours.",
  "scoreVersion": "1.0"
}
