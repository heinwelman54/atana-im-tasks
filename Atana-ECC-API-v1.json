{
  "title": "Atana ECC API",
  "version": "1.0",
  "base": "/v1/ecc",
  "auth": {
    "people": "Entra OIDC",
    "scopes": ["atana.ecc.read", "atana.ecc.watchlist.write", "atana.read"]
  },
  "routes": [
    {"method": "GET", "path": "/scores/portfolios/{id}", "scope": "atana.ecc.read"},
    {"method": "GET", "path": "/scores/projects/{id}", "scope": "atana.ecc.read"},
    {"method": "GET", "path": "/scores/projects/{id}/assets", "scope": "atana.ecc.read"},
    {"method": "GET", "path": "/kpis", "scope": "atana.ecc.read"},
    {"method": "GET", "path": "/snapshots/{id}", "scope": "atana.ecc.read"},
    {"method": "POST", "path": "/snapshots", "scope": "atana.plan.write", "note": "IM freeze"},
    {"method": "GET", "path": "/watchlists", "scope": "atana.ecc.read"},
    {"method": "POST", "path": "/watchlists", "scope": "atana.ecc.watchlist.write"},
    {"method": "POST", "path": "/ask", "scope": "atana.read", "wraps": "/v1/ask"},
    {"method": "GET", "path": "/graph/why/{nodeId}", "scope": "atana.read"},
    {"method": "GET", "path": "/graph/impact/{nodeId}", "scope": "atana.read"},
    {"method": "GET", "path": "/insights/projects/{id}", "scope": "atana.ecc.read"},
    {"method": "GET", "path": "/alerts", "scope": "atana.ecc.read"}
  ],
  "graphql": ["projectCommand", "portfolioHeat", "why", "impact"],
  "eventsEmitted": ["ecc.score.dropped.v1", "ecc.snapshot.frozen.v1", "ecc.alert.acknowledged.v1"],
  "copilotUtterances": {
    "Show all projects at risk": "PH<70 OR P1>0",
    "Which projects are behind schedule": "forecast_delay_d>0 OR DEL_ontime<0.85",
    "Which assets are not operationally ready": "AH<gate OR OR component missing",
    "What are the top information risks": "IDS fail + unsatisfied EIR/AIR",
    "What is causing low compliance": "IDS fail grouped by template/attr",
    "Generate recovery plan for Stage 4": "atnAnswer recover",
    "Show OIR to AIM traceability": "why(asset|attr)",
    "Which project has the highest information maturity": "max IH"
  }
}
