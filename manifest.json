{
  "id": "/",
  "name": "Atana-IM-Tasks",
  "short_name": "Atana-IM-Tasks",
  "description": "Information Manager workspace for ISO 19650 projects: task WBS/Gantt, MIDP, Digital Plan of Works, clash matrix, progress and timesheets.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#2b0729",
  "theme_color": "#3e0b3b",
  "categories": ["business", "productivity", "utilities"],
  "iarc_rating_id": "",
  "prefer_related_applications": false,
  "related_applications": [],
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": ["focus-existing", "auto"]
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Atana IM Tasks desktop workspace"
    },
    {
      "src": "screenshots/mobile.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Atana IM Tasks mobile workspace"
    }
  ],
  "shortcuts": [
    {
      "name": "Open projects",
      "short_name": "Projects",
      "description": "View and open IM projects",
      "url": "./index.html#projects",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Progress overview",
      "short_name": "Progress",
      "description": "Hours and outstanding tasks",
      "url": "./index.html#progress",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "WBS / Gantt",
      "short_name": "WBS",
      "description": "Work breakdown and schedule",
      "url": "./index.html#wbs",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "MIDP tool",
      "short_name": "MIDP",
      "description": "Master Information Delivery Plan",
      "url": "./index.html#midp",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/json": [".json"]
      },
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "project",
          "accept": ["application/json", ".json"]
        }
      ]
    }
  },
  "protocol_handlers": [],
  "note_taking": false,
  "widgets": []
}
