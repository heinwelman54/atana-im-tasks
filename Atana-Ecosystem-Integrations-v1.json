  "bindingKeys": {
    "project": "atana.projectId <-> external.projectId",
    "container": "iso19650Name + external.lineageUrn",
    "element": "ifcGuid | revitUniqueId + containerId",
    "asset": "atana.assetId <-> external.assetnum",
    "person": "entraObjectId"
  },
  "policies": {
    "primaryCde": "Exactly one file SoR per project",
    "lastWriteWins": false,
    "opsWinsAfterHandover": "optional, operating fields only",
