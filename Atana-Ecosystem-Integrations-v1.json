{
  "title": "Atana Ecosystem Integrations",
  "version": "1.0",
  "updated": "2026-08-31",
  "principle": "Do not redesign OIR/PIR/EIR/AIR/AIM. Classify each product and bind fields.",
  "systemClasses": {
    "systemOfRecord": "Authoritative write and durable ID for a named entity or field",
